    <string name="pc_status_idle">等待操作</string>
    <string name="pc_status_working">正在处理…</string>
    <string name="pc_status_testing">正在测试连接…</string>
    <string name="pc_status_preparing_backup">正在准备备份…</string>
    <string name="pc_status_loading_snapshots">正在读取远端快照…</string>
